# ─────────────────────────────────────────────────────────────────────────────
# insta-bot — environment template
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env      (Windows PowerShell:  Copy-Item .env.example .env)
#
# `.env` is gitignored and holds your real secrets — this template is safe to
# commit. Every value below with `CHANGE_ME` / `<...>` MUST be replaced.
# Values shown as real defaults (URLs, booleans) can be left as-is for local use.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────
# Local:      HOST=127.0.0.1
# In Docker / to expose it on the network: HOST=0.0.0.0
HOST=127.0.0.1
PORT=4000
# development | production
ENV=development

# ─── Database (JSON-file store, path relative to backend/) ─────────────────
DB_FILE=data/store.json

# ─── Playwright automation ───────────────────────────────────────────────
# false = you SEE the Chrome window (local desktop). true = headless (servers,
# Docker — there is no display to show a window on).
PLAYWRIGHT_HEADLESS=false
# chrome   = your installed Google Chrome (local desktop only).
# chromium = Playwright's bundled build (use this in Docker/servers).
PLAYWRIGHT_CHANNEL=chrome
# Where "Open Chrome" lands when the URL box is empty. Empty = blank window.
PLAYWRIGHT_START_URL=
PLAYWRIGHT_SLOWMO=0
# Persistent on-disk Chrome profile — log in once, stay logged in. Rel. to backend/.
PLAYWRIGHT_USER_DATA_DIR=data/chrome-profile
# true = launch as a normal Chrome (no "controlled by automated software" bar).
PLAYWRIGHT_CLEAN_LAUNCH=true

# ─── Proxy (optional, recommended for anti-detection) ────────────────────
# Route the browser through a residential/mobile proxy so automation isn't on a
# flagged datacenter IP. One proxy per session, held for the whole run (Instagram
# treats an IP change on a logged-in session as a suspicious login). Leave
# PROXY_SERVER empty to run without a proxy.
#   PROXY_SERVER e.g.  http://host:port   or   socks5://host:port
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Comma-separated hosts that skip the proxy (e.g. localhost,127.0.0.1).
PROXY_BYPASS=

# ─── Instagram login (optional) ──────────────────────────────────────────
# Only needed for the "Log in to Instagram" button. Leave empty to log in by
# hand — the profile above remembers the session either way.
# NEVER commit real credentials. Instagram challenges automated logins.
IG_USERNAME=
IG_PASSWORD=

# ─── MinIO (object storage) ──────────────────────────────────────────────
# Local:  MINIO_URL=localhost:9000
# Docker Compose: MINIO_URL=minio:9000 (the service name).
# Compose ALSO reads MINIO_USER / MINIO_PASSWORD from here to seed the server,
# so set them once and both the app and the minio container use the same pair.
MINIO_URL=localhost:9000
MINIO_USER=CHANGE_ME_minio_access_key
MINIO_PASSWORD=CHANGE_ME_minio_secret_key
MINIO_BUCKET=insta-bot-usernames
# Buckets the app auto-creates; override only if you want different names.
MINIO_BUCKET_SESSIONS=insta-bot-sessions
MINIO_BUCKET_MEDIA=insta-bot-media
MINIO_BUCKET_MESSAGES=insta-bot-messages
